// Source for diagram/process-flow.png
// Render: dot -Tpng -Gdpi=110 prototype/flow.dot -o diagram/process-flow.png
digraph triage {
  graph [rankdir=TB, fontname="Arial", fontsize=26, nodesep=0.6, ranksep=0.45, pad=0.4, newrank=true,
         label=<<b>AI proposal triage: from criteria setup to award</b>>, labelloc=t];
  node  [fontname="Arial", fontsize=16, margin="0.14,0.08", penwidth=1.6, style=filled, width=5.2];
  edge  [fontname="Arial", fontsize=14, penwidth=1.4, color="#444444", arrowsize=0.8];

  // Step types: RULE = blue box, AI = purple hexagon, HUMAN = orange oval, outcome = grey note
  node [shape=box, fillcolor="#DBEAFE", color="#1D4ED8", group=main];

  subgraph cluster_flow {
    label=<<i>Production: every step writes to the audit log (bottom). Prototype: extraction and each scoring run are logged.</i>>;
    labeljust=l; fontsize=17; style="rounded,dashed"; color="#6B7280"; margin=18;

    admin  [shape=ellipse, fillcolor="#FFEDD5", color="#C2410C",
            label=<<b>0. Admin sets criteria</b><br/>HUMAN + RULE<br/><font point-size="14">gates, weights (rule: sum = 100), scoring method<br/>per criterion. Each save = new locked version</font>>];
    upload [shape=ellipse, fillcolor="#FFEDD5", color="#C2410C",
            label=<<b>1. Upload</b><br/>HUMAN<br/><font point-size="14">reviewer adds PDFs, picks category;<br/>run pins the criteria version</font>>];
    intake [label=<<b>2. Intake</b><br/>RULE<br/><font point-size="14">file hash + duplicate check, text extraction / OCR,<br/>text-quality check</font>>];
    scan   [label=<<b>3. Suspicious-instruction scan</b><br/>RULE<br/><font point-size="14">keyword / pattern search for text<br/>aimed at automated reviewers</font>>];
    extract [shape=hexagon, fillcolor="#EDE9FE", color="#6D28D9", margin="0.02,0.02",
            label=<<b>4. Fact extraction</b><br/>AI<br/><font point-size="14">one call per file; pinned model + prompt; JSON facts<br/>with status + verbatim evidence. Never scores or ranks</font>>];
    validate [label=<<b>5. Validation</b><br/>RULE<br/><font point-size="14">schema check, quote must appear in source,<br/>plausible numbers; a price in another currency is flagged</font>>];
    cp1    [shape=ellipse, fillcolor="#FFEDD5", color="#C2410C",
            label=<<b>6. Checkpoint 1: fact review</b><br/>HUMAN<br/><font point-size="14">confirm unclear / missing / unverified facts<br/>against evidence; edits need a reason</font>>];
    gates  [label=<<b>7. Mandatory gates</b><br/>RULE<br/><font point-size="14">licence; WSIB + insurance. Missing info never auto-rejects</font>>];
    score  [label=<<b>8. Weighted scoring</b><br/>RULE<br/><font point-size="14">fixed formulas, eligible bids only</font>>];
    status [label=<<b>9. Status, rank, reasons</b><br/>RULE<br/><font point-size="14">flag checks, tie-breaks, template reasons (no AI)</font>>];
    cp2    [shape=ellipse, fillcolor="#FFEDD5", color="#C2410C",
            label=<<b>10. Checkpoint 2: ranking review</b><br/>HUMAN<br/><font point-size="14">resolve flags, see per-criterion points + evidence;<br/>overrides need a reason</font>>];
    cp3    [shape=ellipse, fillcolor="#FFEDD5", color="#C2410C",
            label=<<b>11. Checkpoint 3: award</b><br/>HUMAN<br/><font point-size="14">a person makes the final decision; the run is then locked</font>>];

    node [shape=note, color="#4B5563", fontsize=15, width=2.6, group=""];
    inel   [fillcolor="#FEE2E2", label=<<b>Ineligible</b><br/><font point-size="14">explicit gate fail;<br/>not scored</font>>];
    ranked [fillcolor="#DCFCE7", label=<<b>Ranked list</b><br/><font point-size="14">rank 1..n, each with<br/>a one-line reason</font>>];
    flag   [fillcolor="#FEF9C3", label=<<b>Flagged</b><br/><font point-size="14">held for a human; no rank,<br/>score null (provisional<br/>total in the reason)</font>>];

    // Main flow: one column, top to bottom
    admin -> upload -> intake -> scan -> extract -> validate [weight=10];
    validate -> cp1 [weight=10, label=" facts + evidence "];
    cp1 -> gates [weight=10];
    gates -> score [weight=10, label=" pass or unconfirmed "];
    score -> status [weight=10];
    status -> ranked [label=" clean "];
    status -> flag [label=" any flag "];
    ranked -> cp2;
    flag -> cp2;
    cp2 -> cp3 [weight=10];
    { rank=same; inel; score; }
    inel -> score [style=invis];               // Ineligible sits left of scoring
    { rank=same; ranked; flag; }
    ranked -> flag [style=invis];              // Ranked left, Flagged right
    gates -> inel [label=" explicit fail "];
    inel -> cp2 [style=dotted, label=" visible to\n reviewer "];

    // Exception and re-run routes (dashed): right side feeds Flagged, left side loops back to the gates
    edge [style=dashed, color="#B45309", fontcolor="#B45309"];
    scan -> flag [label=" any hit "];
    extract -> flag [label=" extraction\n failed "];
    admin -> gates [label=" criteria edited:\n new version,\n rescore (no AI) "];
    cp2 -> gates [label=" flag resolved:\n rescore\n (rules only) "];
  }

  edge [style=solid, color="#444444"];
  audit [shape=box, style="filled,rounded", fillcolor="#F3F4F6", color="#374151", fontsize=16, width=11, group="",
         label=<<b>Audit log (production: spans all steps; prototype: extraction + each scoring run)</b><br/>user + timestamp | file hashes | criteria version | model id + prompt version/hash<br/>raw AI output | validated facts | human edits and overrides with reasons<br/>scores and reasons | final award decision>];
  cp3 -> audit [style=invis];
  audit -> l_human [style=invis];

  subgraph cluster_legend {
    label=<<b>Legend</b>>; fontsize=16; style=rounded; color="#9CA3AF"; margin=12;
    node [fontsize=15, width=2.2, group=""];
    l_ai    [shape=hexagon, fillcolor="#EDE9FE", color="#6D28D9", label="AI step"];
    l_rule  [shape=box, fillcolor="#DBEAFE", color="#1D4ED8", label="Rule / code step"];
    l_human [shape=ellipse, fillcolor="#FFEDD5", color="#C2410C", label="Human checkpoint"];
    l_out   [shape=note, fillcolor="#FFFFFF", color="#4B5563", label="Outcome"];
    l_ai -> l_rule -> l_human -> l_out [style=invis];
  }
  { rank=same; l_ai; l_rule; l_human; l_out; }
}
